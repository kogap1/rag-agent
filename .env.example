# 将 auto 改为 cpu 或 cuda 可强制指定设备
DEVICE=auto
# 多卡机器（如 4×A40）建议固定单卡。不设置时 models.py 走 device_map="auto"，
# 会把生成模型自动切分到当前可见的所有 GPU 上，难以隔离排障、也不便与其他任务共享机器。
# 需要多卡推理时再显式改成 0,1,2,3。
CUDA_VISIBLE_DEVICES=0
MODEL_CACHE_DIR=models
VECTOR_DB_DIR=server_vector_db
UPLOAD_DIR=uploaded_files
METADATA_DB_PATH=state/documents.sqlite3

EMBEDDING_MODEL=Xorbits/bge-m3
RERANKER_MODEL=Xorbits/bge-reranker-base
# 本机已有 1.5B 权重，可直接复现；A40 可改为 qwen/Qwen2.5-7B-Instruct
LLM_MODEL=qwen/Qwen2.5-1.5B-Instruct
# local：当前进程内加载 Transformers；openai_compatible：调用 vLLM 等兼容服务
LLM_BACKEND=local
LLM_API_BASE=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_API_TIMEOUT_SECONDS=120

CHUNK_SIZE=700
CHUNK_OVERLAP=100
RECALL_K=20
FINAL_K=6
MAX_AGENT_STEPS=2
# 检索轮数上限：无召回时先改写问题重试，达到上限仍无证据则明确拒答。
MAX_RETRIEVAL_ROUNDS=2
# 保留最近 N 个已激活版本的向量，供升级失败后回退；超出窗口的版本才回收向量。
KEEP_HISTORY_VERSIONS=2
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_MESSAGES=6
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=1
MAX_TOOL_OUTPUT_CHARS=12000
ENABLE_RERANKER=true

# HTTP 服务。run_server.sh 首次运行会自动生成强随机 API_KEY 并写回 .env。
API_KEY=
API_MAX_CONCURRENCY=1
MAX_UPLOAD_BYTES=52428800
INGESTION_LEASE_SECONDS=900

# MCP Streamable HTTP 挂载在 /mcp/。部署到服务器时将公网域名或IP显式加入白名单。
# 例：MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,<你的服务器IP>:*,rag.example.com,rag.example.com:*
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# 浏览器MCP客户端才需要配置Origin；普通服务端客户端不发送Origin。
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# run_server.sh 默认只复用已有 Conda 环境，不会创建环境或安装依赖。
# 留空时优先使用当前已激活的非 base 环境；也可填写已有环境名。
DEPLOY_MODE=conda
CONDA_ENV_NAME=
REQUIRE_CUDA=1

# 可选：填入 API 单价（美元/百万 token）后，评测报告会额外给出美元成本。
# 本地模型留 0 即可，报告仍会输出 token 消耗。
# COST_PER_1M_INPUT_TOKENS=0.5
# COST_PER_1M_OUTPUT_TOKENS=1.5
